# 生产镜像（构建于部署服务器本地：该机 Docker Hub 被阻断，改用腾讯云镜像加速 + 国内源）
# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS base
ENV NEXT_TELEMETRY_DISABLED=1

# 生产机出口受限：Debian 官方源在容器内极慢，统一切到腾讯云镜像（内网命中）
# bookworm 使用 deb822 格式（/etc/apt/sources.list.d/debian.sources），同时兼容旧格式
RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
      if [ -f "$f" ]; then \
        sed -i -e 's|https\?://deb.debian.org|https://mirrors.cloud.tencent.com|g' \
               -e 's|https\?://security.debian.org|https://mirrors.cloud.tencent.com|g' "$f"; \
      fi; \
    done

# ---------- 依赖 ----------
FROM base AS deps
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# npm 与 Prisma 引擎走国内镜像（npm ci 会用 replace-registry-host 改写 lockfile 中的 registry 域名）
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com \
    PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma \
    npm_config_audit=false \
    npm_config_fund=false
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund \
 && npx prisma generate

# ---------- 构建 ----------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# 构建期不需要真实数据库，给占位串避免误连生产库
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public" \
    NODE_OPTIONS=--max-old-space-size=1536
RUN npm run build
# 硬性校验：standalone 必须存在，否则镜像必然无法启动
RUN test -f .next/standalone/server.js \
 || (echo "FATAL: .next/standalone 缺失，检查 next.config 的 output: 'standalone'" && exit 1)

# ---------- 运行 ----------
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    TZ=Asia/Shanghai
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 1001 nodejs \
 && useradd -u 1001 -g nodejs -m nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=20s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]

# 数据库连接串（本地开发，独立 PG 实例端口 55433）
DATABASE_URL="postgresql://postgres@127.0.0.1:55433/physchem_v1?schema=public"

# 应用会话密钥（生产必须替换，至少 32 字节随机值）
SESSION_SECRET="change-me-in-production-use-a-long-random-string"

# 时区
TZ="Asia/Shanghai"

# AI Provider（V1 可留空，训练使用固定 Hint fallback）
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""

# 生产是否需要 HTTPS 强制
NODE_ENV="development"

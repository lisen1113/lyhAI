# ===== 生产环境变量模板 =====
# 部署时复制为 /opt/phychem-trainer/.env，权限设为 600，切勿提交到仓库。

# 应用镜像（在部署服务器本地构建：docker compose build）
# 该机 Docker Hub 被阻断，无法从外部仓库拉取，故不使用 ghcr.io 地址
APP_IMAGE=phychem-app:1.0.0
APP_VERSION=1.0.0

# 运维工具镜像（迁移与灌数据用，一次性容器，本地构建）
TOOLS_IMAGE=phychem-tools:1.0.0

# 对外端口（本阶段 8088）
APP_PORT=8088

# 数据库
PG_DATABASE=physchem_v1
PG_USER=physchem
# 生成方式：openssl rand -hex 24
PG_PASSWORD=

# 学生初始密码（首次初始化时写入，之后改密码需另行处理）
SEED_PASSWORD=

# 资源限额（按服务器实际可用内存调整；低于 1.5GB 可用内存请勿部署）
APP_MEM=768m
APP_CPUS=0.8
DB_MEM=512m
DB_CPUS=0.5

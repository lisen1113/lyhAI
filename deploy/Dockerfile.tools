# 一次性运维工具镜像：迁移 + 灌数据（构建于部署服务器本地，运行时一次性使用）
# 构建：docker build -f deploy/Dockerfile.tools -t phychem-tools:1.0.0 .
FROM node:22-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# 与生产镜像保持一致：Debian 源切腾讯云镜像
# 必须用 http：基础镜像未内置 CA 根证书，https 会握手失败；apt 靠 GPG 验签保证完整性
RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
      if [ -f "$f" ]; then \
        sed -i -e 's|https\?://deb.debian.org|http://mirrors.cloud.tencent.com|g' \
               -e 's|https\?://security.debian.org|http://mirrors.cloud.tencent.com|g' "$f"; \
      fi; \
    done

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com \
    PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma \
    npm_config_audit=false \
    npm_config_fund=false

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund && npx prisma generate

# 运维脚本依赖 prisma/ 下的数据文件（题库、知识树），必须一并带上
COPY scripts ./scripts

CMD ["npx", "tsx", "--version"]
